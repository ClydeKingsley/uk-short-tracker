<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <runtime>
    <!--
      Windows propagates Mark of the Web from a downloaded ZIP to extracted
      managed assemblies. .NET Framework otherwise refuses Assembly.LoadFrom
      for those local files, which makes pythonnet report the misleading
      "Failed to resolve Python.Runtime.Loader.Initialize" error.

      The application already trusts and executes this extracted distribution
      as one unit. This setting is isolated to Short Tracker's pythonnet
      AppDomain and allows the reviewed bundled assemblies to load even while
      the ZIP's Internet-zone marker is still present.
    -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
